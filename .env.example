# ==============================================================================
# CarbonOps Scheduler Environment Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Google Gemini AI API Key (Required for Live Gemini 3 Advisory Engine)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GEMINI_MODEL: Gemini model used by the AI optimization engine.
# Defaults to "gemini-3-flash-preview". Use "gemini-3-pro-preview" for deeper reasoning.
GEMINI_MODEL=gemini-3-flash-preview

# APP_URL: The base URL where this applet is hosted.
APP_URL=http://localhost:3000

# ELECTRICITY_API_KEY: Optional API key for Electricity Maps v3 real-time carbon telemetry.
# If omitted, a realistic multi-region grid intensity telemetry model is used.
ELECTRICITY_API_KEY=

# ------------------------------------------------------------------------------
# AWS SQS DUAL-MODE INTEGRATION (Optional — Production Live Mode)
# When set, enqueue and deploy decisions are dispatched directly to real AWS SQS.
# When omitted, the platform automatically runs in zero-config SANDBOX mode
# with an in-memory queue and SHA-256 local ledger.
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SQS_QUEUE_URL=